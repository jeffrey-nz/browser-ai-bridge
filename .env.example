# Port for the API server (default: 3333)
PORT=3333

# Chrome DevTools Protocol URL (default: http://127.0.0.1:9222)
# Set this if Chrome is running on a non-default port
CDP_URL=http://127.0.0.1:9222

# Chrome CDP port used when the server auto-launches Chrome (default: 9222)
# T-064: if a launch attempt falls through to auto-launching Chrome (CDP_URL
# unreachable or nothing answering there), whatever OWNS this port gets
# killed first to make room for the fresh one -- regardless of what CDP_URL
# names. Setting CDP_URL to point at a different, already-running bridge's
# Chrome WITHOUT also setting CDP_PORT to that same port does not "read
# there, write here": if that fallback is ever reached, it kills the
# process on port 9222 by default, which may or may not be what CDP_URL
# named. Point both at the SAME port when you mean to share an existing
# Chrome with another bridge instance.
CDP_PORT=9222

# Name of Chrome's profile folder under ~/.browser-ai-bridge/ (built-in default
# when unset: chrome-profile). Change this to isolate profiles between instances.
CHROME_TMP=chrome_ai_debug

# Set to "true" to run Chrome in headless mode (useful for CI/servers)
HEADLESS=false

# Log level: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info

# Set to "1"/"true" to assume every provider is already logged in: skips the
# first-run login detection and the Ready/Skip confirmation (no prompts, no checks).
BROWSER_AI_ASSUME_LOGGED_IN=false

# Provider tier chain: who answers when the one you asked for cannot.
#
# An ordered, comma-separated preference list used when a request names a
# provider but no chain of its own. A rate limit is a property of an account
# and a clock -- Gemini cooling down says nothing about whether ChatGPT could
# answer right now -- so a batch that stops dead for two minutes each time is a
# batch whose wall-clock is set by its unluckiest provider.
#
# The chain is a PREFERENCE, not a pool: tier 0 is asked whenever it is
# available, so a fallback lasts exactly as long as the cooldown that caused it
# and nothing has to remember to switch back. Every response carries `provider`
# so a caller can tell who actually spoke.
#
# Leave empty for the old behaviour: one provider, and a cooldown is a 429.
PROVIDER_TIERS=

# ---------------------------------------------------------------------------
# Optional tuning. Everything below is commented out: the value shown is the
# built-in default, so uncomment only what you mean to change.
# ---------------------------------------------------------------------------

# Only start these providers (comma-separated ids, e.g. chatgpt,gemini).
# BROWSER_AI_PROVIDERS=

# Chrome profile directory (default: ~/.browser-ai-bridge/<CHROME_TMP>).
# CHROME_USER_DATA_DIR=
# Cap on Chrome renderer processes; same-site tabs share one.
# CHROME_RENDERER_LIMIT=4

# Warm standby tabs kept per provider.
# POOL_SIZE=1
# Idle session lifetime, and how often expired sessions are collected.
# SESSION_TTL_MS=900000
# GC_INTERVAL_MS=300000
# How long a request waits for a busy provider to free a session.
# SESSION_CAPACITY_WAIT_MS=120000
# Budget for recycling a session after a turn before its lock is released.
# SESSION_CLEANUP_TIMEOUT_MS=15000

# Tab janitor (see CLAUDE.md, "Tab management").
# MAX_TABS_PER_PROVIDER=3
# TAB_IDLE_GRACE_MS=90000
# ABANDONED_TURN_MS=300000
# TAB_ORPHAN_GRACE_MS=150000
# TAB_POOL_IDLE_MS=600000
# MAX_BLANK_TABS=1
# TAB_SWEEP_INTERVAL_MS=60000

# Copilot prompt length before the compactor trims it.
# COPILOT_MAX_CHARS=32000

# Test/diagnostic overrides; the defaults are measured values.
# BROWSER_DEADLOCK_TIMEOUT_MS=10000
# CDP_BIND_TIMEOUT_MS=60000
# LONG_RUNNING_THRESHOLD_MS=120000
