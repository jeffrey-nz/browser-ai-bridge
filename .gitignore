# Dependencies
node_modules/

# Runtime output
logs/
reports/*
!reports/vision-probe/
reports/vision-probe/*
!reports/vision-probe/*.json
# T-026: fixture PNGs ARE tracked (unlike everything else under reports/) —
# they're this probe's evidence, not disposable runtime output: small
# (~4KB each, ~230KB total as of this ticket), and a clone that doesn't
# have them can never re-run scripts/fixture-audit.mjs or otherwise verify
# what a historical run actually showed a provider. *.log files under
# reports/vision-probe/ stay ignored — those are disposable.
!reports/vision-probe/*.png
snapshots/

# Environment & secrets
.env

# Editor & OS
.DS_Store
.vscode/
.claude/

# Runtime state
.api.pid
.api-config.json
.last-ai-response.md
